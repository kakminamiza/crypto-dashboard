    <!-- Main Content -->
    <main class="container">
        <!-- Header -->
        <section class="header-section">
            <h1 class="page-title">
                <span class="icon">📊</span>
                Crypto Accumulation Scanner
            </h1>
            <p class="page-subtitle">
                เกณฑ์ 5 ข้อ: <span class="highlight">สะสมเงิน</span> / 
                <span class="highlight">Vol&gt;1.5M</span> / 
                <span class="highlight">ทดสอบซื้อ</span> / 
                <span class="highlight">Social</span> / 
                <span class="highlight">Breakout&gt;0.8</span> · 
                อัปเดต 2026-09-13 22:05
            </p>
        </section>

        <!-- Controls -->
        <div class="controls">
            <div class="control-group">
                <span class="control-label">เกรด:</span>
                <button class="btn active" onclick="filterGrade('all')">ทั้งหมด</button>
                <button class="btn" onclick="filterGrade('A+')">A+</button>
                <button class="btn" onclick="filterGrade('A')">A</button>
                <button class="btn" onclick="filterGrade('Watch')">Watch</button>
            </div>
            <div class="control-group">
                <span class="control-label">เรียงตาม:</span>
                <select class="select-box" id="sortSelect" onchange="sortCoins()">
                    <option value="score">คะแนน</option>
                    <option value="change">% เปลี่ยนแปลง</option>
                    <option value="volume">Volume</option>
                    <option value="rsi">RSI</option>
                </select>
            </div>
            <div class="control-group" style="margin-left: auto;">
                <button class="btn btn-primary" onclick="refreshData()">🔄 รีเฟรช</button>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-bar">
            <div class="stat-card">
                <div class="stat-value" id="statTotal">0</div>
                <div class="stat-label">เหรียญที่สแกน</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="statAPlus">0</div>
                <div class="stat-label">เกรด A+</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="statA">0</div>
                <div class="stat-label">เกรด A</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="statWatch">0</div>
                <div class="stat-label">Watch</div>
            </div>
        </div>

        <!-- Scanner Grid -->
        <div class="scanner-grid" id="scannerGrid">
            <div class="loading">
                <div class="loading-spinner"></div>
                กำลังโหลดข้อมูล...
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        Crypto Accumulation Scanner · ดึงข้อมูลจาก Binance · ใช้เพื่อการวิเคราะห์เท่านั้น
    </footer>

    <script>
        // ============================================================
        // ข้อมูลตัวอย่าง (แทนที่ด้วยข้อมูลจริงจาก API ของคุณ)
        // ============================================================
        let allCoins = [
            {
                symbol: "ENSOUSDT",
                name: "ENSO",
                price: 1.0150,
                change14d: 10.4,
                high14d: 0.9760,
                adx: 19.1,
                rsi: 13.6,
                volume: 2100000,
                score: 4,
                maxScore: 5,
                grade: "A+",
                criteria: ["สะสมเงิน", "Vol>1.5M", "ทดสอบซื้อ", "Social", "Breakout>0.8"],
                passed: [true, true, true, true, false],
                sparkline: [0.92, 0.94, 0.93, 0.95, 0.96, 0.95, 0.97, 0.98, 0.99, 1.015]
            },
            {
                symbol: "EPICUSDT",
                name: "EPIC",
                price: 0.9224,
                change14d: 8.9,
                high14d: 1.1627,
                adx: 6.4,
                rsi: 29.3,
                volume: 1800000,
                score: 4,
                maxScore: 5,
                grade: "A+",
                criteria: ["สะสมเงิน", "Vol>1.5M", "ทดสอบซื้อ", "Social", "Breakout>0.8"],
                passed: [true, true, true, true, false],
                sparkline: [0.85, 0.87, 0.86, 0.88, 0.89, 0.90, 0.91, 0.915, 0.92, 0.9224]
            },
            {
                symbol: "AXTIBUSDT",
                name: "AXTIB",
                price: 75.3500,
                change14d: 7.8,
                high14d: 79.4000,
                adx: null,
                rsi: null,
                volume: 2500000,
                score: 4,
                maxScore: 5,
                grade: "A+",
                criteria: ["สะสมเงิน", "Vol>1.5M", "ทดสอบซื้อ", "Social", "Breakout>0.8"],
                passed: [true, true, true, true, false],
                sparkline: [70, 71, 70.5, 72, 73, 72.5, 74, 74.5, 75, 75.35]
            },
            {
                symbol: "BNBUSDT",
                name: "BNB",
                price: 592.0000,
                change14d: 4.8,
                high14d: 605.5000,
                adx: 13.6,
                rsi: 51.9,
                volume: 3200000,
                score: 4,
                maxScore: 5,
                grade: "A",
                criteria: ["สะสมเงิน", "Vol>1.5M", "ทดสอบซื้อ", "Social", "Breakout>0.8"],
                passed: [true, true, true, false, false],
                sparkline: [565, 570, 568, 575, 580, 578, 585, 588, 590, 592]
            },
            {
                symbol: "NVDABUSDT",
                name: "NVDAB",
                price: 219.1500,
                change14d: -0.6,
                high14d: 222.3900,
                adx: null,
                rsi: null,
                volume: 900000,
                score: 3,
                maxScore: 5,
                grade: "Watch",
                criteria: ["สะสมเงิน", "Vol>1.5M", "ทดสอบซื้อ", "Social", "Breakout>0.8"],
                passed: [true, false, true, true, false],
                sparkline: [220, 219.5, 219, 218.5, 219, 219.2, 218.8, 219.1, 219.3, 219.15]
            }
        ];

        let currentFilter = 'all';

        // ============================================================
        // ฟังก์ชันสร้าง Sparkline SVG
        // ============================================================
        function createSparkline(data, positive) {
            if (!data || data.length < 2) return '';
            
            const width = 280;
            const height = 60;
            const padding = 4;
            
            const min = Math.min(...data);
            const max = Math.max(...data);
            const range = max - min || 1;
            
            const points = data.map((val, i) => {
                const x = (i / (data.length - 1)) * width;
                const y = height - padding - ((val - min) / range) * (height - padding * 2);
                return `${x},${y}`;
            }).join(' ');
            
            const color = positive ? 'var(--accent-green)' : 'var(--accent-red)';
            const gradientId = `grad-${Math.random().toString(36).substr(2, 9)}`;
            
            return `
                <svg class="sparkline" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="${gradientId}" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" style="stop-color:${color};stop-opacity:0.3" />
                            <stop offset="100%" style="stop-color:${color};stop-opacity:0" />
                        </linearGradient>
                    </defs>
                    <polygon points="0,${height} ${points} ${width},${height}" fill="url(#${gradientId})" />
                    <polyline points="${points}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            `;
        }

        // ============================================================
        // ฟังก์ชันสร้าง Score Dots
        // ============================================================
        function createScoreDots(score, maxScore) {
            let dots = '';
            for (let i = 0; i < maxScore; i++) {
                dots += `<span class="score-dot ${i < score ? 'filled' : ''}"></span>`;
            }
            return dots;
        }

        // ============================================================
        // ฟังก์ชันกำหนด Class ของ Badge
        // ============================================================
        function getBadgeClass(grade) {
            if (grade === 'A+') return 'score-badge';
            if (grade === 'A') return 'score-badge score-a';
            if (grade === 'Watch') return 'score-badge score-watch';
            return 'score-badge score-skip';
        }

        // ============================================================
        // ฟังก์ชันแสดงค่า Metric (แก้ปัญหา null/undefined)
        // ============================================================
        function formatMetric(value, suffix = '') {
            if (value === null || value === undefined || isNaN(value)) {
                return `<span style="color: var(--text-muted)">-</span>`;
            }
            return `${value.toFixed(1)}${suffix}`;
        }

        // ============================================================
        // ฟังก์ชันสร้างการ์ดเหรียญ
        // ============================================================
        function createCoinCard(coin) {
            const changeClass = coin.change14d >= 0 ? 'positive' : 'negative';
            const changeSign = coin.change14d >= 0 ? '+' : '';
            const badgeClass = getBadgeClass(coin.grade);
            
            const criteriaTags = coin.criteria.map((c, i) => {
                const passClass = coin.passed[i] ? 'pass' : 'fail';
                const icon = coin.passed[i] ? '✓' : '✗';
                return `<span class="tag ${passClass}">${icon} ${c}</span>`;
            }).join('');
            
            return `
                <article class="coin-card" data-grade="${coin.grade}">
                    <div class="card-header">
                        <div class="coin-name">
                            <span class="coin-symbol">${coin.name}</span>
                            <span class="coin-pair">${coin.symbol} · 24h Vol $${(coin.volume / 1000000).toFixed(2)}M</span>
                        </div>
                        <div class="${badgeClass}">
                            <div class="score-dots">${createScoreDots(coin.score, coin.maxScore)}</div>
                            SCORE ${coin.score}/${coin.maxScore}
                        </div>
                    </div>
                    
                    <div class="price-section">
                        <span class="current-price">$${coin.price.toFixed(4)}</span>
                        <span class="price-change ${changeClass}">${changeSign}${coin.change14d.toFixed(1)}%</span>
                    </div>
                    
                    <div class="chart-container">
                        ${createSparkline(coin.sparkline, coin.change14d >= 0)}
                    </div>
                    
                    <div class="metrics-grid">
                        <div class="metric">
                            <div class="metric-label">14d High</div>
                            <div class="metric-value">$${coin.high14d.toFixed(4)}</div>
                        </div>
                        <div class="metric">
                            <div class="metric-label">จาก High</div>
                            <div class="metric-value ${coin.price >= coin.high14d * 0.95 ? 'strong' : ''}">
                                ${((coin.price / coin.high14d - 1) * 100).toFixed(1)}%
                            </div>
                        </div>
                        <div class="metric">
                            <div class="metric-label">ADX(14) 4h</div>
                            <div class="metric-value">${formatMetric(coin.adx)}</div>
                        </div>
                        <div class="metric">
                            <div class="metric-label">RSI(14) 4h</div>
                            <div class="metric-value ${coin.rsi !== null && coin.rsi < 30 ? 'strong' : ''}">
                                ${formatMetric(coin.rsi)}
                            </div>
                        </div>
                    </div>
                    
                    <div class="criteria-tags">
                        ${criteriaTags}
                    </div>
                </article>
            `;
        }

        // ============================================================
        // ฟังก์ชันแสดงผลทั้งหมด
        // ============================================================
        function renderCoins(coins) {
            const grid = document.getElementById('scannerGrid');
            
            if (coins.length === 0) {
                grid.innerHTML = `
                    <div class="empty-state">
                        <h3>ไม่พบเหรียญที่ตรงเงื่อนไข</h3>
                        <p>ลองปรับตัวกรองหรือรีเฟรชข้อมูลใหม่</p>
                    </div>
                `;
                return;
            }
            
            grid.innerHTML = coins.map(createCoinCard).join('');
            updateStats(coins);
        }

        // ============================================================
        // ฟังก์ชันอัปเดตสถิติ
        // ============================================================
        function updateStats(coins) {
            document.getElementById('statTotal').textContent = coins.length;
            document.getElementById('statAPlus').textContent = coins.filter(c => c.grade === 'A+').length;
            document.getElementById('statA').textContent = coins.filter(c => c.grade === 'A').length;
            document.getElementById('statWatch').textContent = coins.filter(c => c.grade === 'Watch').length;
        }

        // ============================================================
        // ฟังก์ชันกรองตามเกรด
        // ============================================================
        function filterGrade(grade) {
            currentFilter = grade;
            
            // อัปเดตปุ่ม active
            document.querySelectorAll('.controls .btn').forEach(btn => {
                btn.classList.remove('active');
                if (btn.textContent.includes(grade) || (grade === 'all' && btn.textContent.includes('ทั้งหมด'))) {
                    btn.classList.add('active');
                }
            });
            
            applyFilterAndSort();
        }

        // ============================================================
        // ฟังก์ชันเรียงลำดับ
        // ============================================================
        function sortCoins() {
            applyFilterAndSort();
        }

        function applyFilterAndSort() {
            let filtered = currentFilter === 'all' 
                ? [...allCoins] 
                : allCoins.filter(c => c.grade === currentFilter);
            
            const sortBy = document.getElementById('sortSelect').value;
            
            filtered.sort((a, b) => {
                if (sortBy === 'score') return b.score - a.score;
                if (sortBy === 'change') return b.change14d - a.change14d;
                if (sortBy === 'volume') return b.volume - a.volume;
                if (sortBy === 'rsi') return (b.rsi || 0) - (a.rsi || 0);
                return 0;
            });
            
            renderCoins(filtered);
        }

        // ============================================================
        // ฟังก์ชันรีเฟรชข้อมูล
        // ============================================================
        function refreshData() {
            const grid = document.getElementById('scannerGrid');
            grid.innerHTML = `
                <div class="loading">
                    <div class="loading-spinner"></div>
                    กำลังโหลดข้อมูล...
                </div>
            `;
            
            // จำลองการโหลด 1 วินาที แล้วแสดงผล
            setTimeout(() => {
                applyFilterAndSort();
            }, 1000);
            
            // ถ้าต่อ API จริง ให้ใช้ fetch ตรงนี้
            // fetch('/api/scanner-data')
            //     .then(r => r.json())
            //     .then(data => {
            //         allCoins = data;
            //         applyFilterAndSort();
            //     });
        }

        // ============================================================
        // โหลดครั้งแรก
        // ============================================================
        document.addEventListener('DOMContentLoaded', () => {
            applyFilterAndSort();
        });
    </script>
</body>
</html>